{
  "name": "switchyard",
  "private": true,
  "version": "0.1.0",
  "description": "Supervise parallel coding sessions in one repository, on top of the Zit engine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:zit": "node scripts/install-zit.mjs",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/main.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run server/lib web/lib",
    "demo": "tsx scripts/demo.ts",
    "demo:reset": "tsx scripts/demo.ts --reset",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "smol-toml": "1.9.0",
    "sonner": "2.0.8",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
