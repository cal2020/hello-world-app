{
  "name": "human-cell-atlas",
  "private": true,
  "version": "1.0.0",
  "description": "An immersive, illustrative 3D atlas of a representative human cell with 19 explorable structures in seven languages.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/prerender.ts",
    "build:fast": "vite build && tsx scripts/prerender.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:fast",
    "check:links": "tsx scripts/check-links.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "perf": "tsx scripts/measure-performance.ts",
    "i18n": "tsx scripts/i18n.ts",
    "illustrations": "tsx scripts/illustrations.ts",
    "check:closeups": "tsx scripts/check-closeups.ts",
    "probe:labels": "tsx scripts/closeup-labels.ts"
  },
  "dependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "camera-controls": "3.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
