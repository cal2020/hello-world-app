# Switchyard configuration. Copy to your shell environment or a process manager;
# Switchyard does not read .env files itself. No secrets are needed.

# Where the API listens. Loopback only unless SWITCHYARD_ALLOW_NON_LOOPBACK=1.
SWITCHYARD_HOST=127.0.0.1
SWITCHYARD_PORT=4780

# Task notes, approvals, check history and the journal (default: ./.switchyard).
SWITCHYARD_DATA_DIR=./.switchyard

# Optional: only repositories under these colon-separated roots may be registered.
SWITCHYARD_ALLOWED_ROOTS=/home/you/code

# The Zit binary (default: ./.tools/bin/zit from `npm run setup:zit`, then PATH).
# ZIT_BIN=/usr/local/bin/zit

# Zit's own storage for workspaces and caches (Zit's default: ~/.zit). Keep it the
# same as for your `git zit` CLI so both see the same workspaces.
# ZIT_HOME=/home/you/.zit
