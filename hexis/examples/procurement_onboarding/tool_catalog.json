        ],
        "properties": {
          "draft_ref": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "record"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "record": {
            "type": "object"
          }
        }
      }
    },
    "draft.verify_persisted": {
      "version": "1.0.0",
      "effect": "pure",
      "capability": "draft:verify",
      "verifier": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approved_draft",
          "persisted",
          "draft_ref",
          "draft_version"
        ],
        "properties": {
          "approved_draft": {
            "type": "object"
          },
          "persisted": {
            "type": "object"
          },
          "draft_ref": {
            "type": "string"
          },
          "draft_version": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "mismatch_fields"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "match",
              "mismatch"
            ]
          },
          "mismatch_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
