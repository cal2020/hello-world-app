# Copy to .env (never commit .env). Every value below is read by compose.yaml.
#
# Database passwords: required. Use hex so they are URL-safe, e.g.  openssl rand -hex 24
AH_OWNER_DB_PASSWORD=
AH_API_DB_PASSWORD=
AH_WORKER_DB_PASSWORD=
AH_SCORER_DB_PASSWORD=

# API exposure. Loopback by default; for remote access put a TLS reverse proxy in front (session cookies are Secure).
AH_API_BIND=127.0.0.1
AH_API_PORT=8765
AH_SESSION_TTL_HOURS=12

# Optional: Hugging Face token for gated downloads (trusted worker / admin / vllm only).
AH_HF_TOKEN=

# Optional: outbound HTTPS proxy for the workers (the judge sandbox's egress proxy chains through it).
AH_EGRESS_PROXY=

# Provider credentials: passed to the judge worker ONLY. Leave empty when not used; runs that need a missing
# credential are planned and blocked, never executed. Live runs also need an explicit budget (see OPERATIONS.md).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
VLLM_API_KEY=
# Codex ChatGPT-subscription auth: the contents of ~/.codex/auth.json on one line.
CODEX_AUTH_JSON=

# Optional vLLM profile (docker compose --profile vllm up -d): GPU host with the NVIDIA container toolkit.
VLLM_MODEL=Qwen/Qwen3.6-27B
VLLM_EXTRA_ARGS=

# Image naming / provenance (optional).
AH_IMAGE_PREFIX=agenthorizon
AH_IMAGE_TAG=local
AH_BUILD_GIT_COMMIT=
