{
  "$defs": {
    "Record": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "additionalProperties": true,
          "title": "Action",
          "type": "object"
        },
        "clause": {
          "default": "",
          "title": "Clause",
          "type": "string"
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        },
        "output": {
          "additionalProperties": true,
          "title": "Output",
          "type": "object"
        },
        "state": {
          "default": "",
          "title": "State",
          "type": "string"
        },
        "step": {
          "title": "Step",
          "type": "integer"
        },
        "vars": {
          "additionalProperties": true,
          "title": "Vars",
          "type": "object"
        }
      },
      "required": [
        "step"
      ],
      "title": "Record",
      "type": "object"
    }
  },
  "$id": "hexis-service/trace.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_hash": {
      "default": "",
      "title": "Artifact Hash",
      "type": "string"
    },
    "error_step": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Step"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/Record"
      },
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "source": {
      "default": "",
      "title": "Source",
      "type": "string"
    },
    "task": {
      "additionalProperties": true,
      "title": "Task",
      "type": "object"
    },
    "tenant_id": {
      "default": "",
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "verdict": {
      "default": "unknown",
      "enum": [
        "accepted",
        "rejected",
        "unknown"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "trace_id"
  ],
  "title": "Trace",
  "type": "object"
}
