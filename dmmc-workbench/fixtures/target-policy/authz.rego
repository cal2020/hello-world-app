# Reviewed policy for the SIMULATED target application (synthetic).
# This is the policy being analysed. It is not the workbench's own authorization,
# and nothing generated by a model may replace it.
package mtel.authz

grants := {
	"operator": {"read"},
	"maintainer": {"read", "write"},
}

required := [
	["subject", "id"],
	["subject", "role"],
	["subject", "project"],
	["subject", "revoked"],
	["action"],
	["resource", "type"],
	["resource", "project"],
]

present(path) if {
	v := object.get(input, path, null)
	v != null
	v != ""
}

deny_reasons contains sprintf("missing-attribute:%s", [concat(".", path)]) if {
	some path in required
	not present(path)
}

deny_reasons contains "cross-project" if input.subject.project != input.resource.project

deny_reasons contains "revoked-subject" if input.subject.revoked == true

deny_reasons contains "explicit-deny:locked-resource" if {
	input.action == "write"
	input.resource.locked == true
}

granted if {
	input.resource.type == "telemetry"
	input.action in grants[input.subject.role]
}

default decision := {"allow": false, "reasons": ["default-deny"]}

decision := {"allow": false, "reasons": sort([r | some r in deny_reasons])} if count(deny_reasons) > 0

decision := {"allow": true, "reasons": ["granted"]} if {
	count(deny_reasons) == 0
	granted
}
