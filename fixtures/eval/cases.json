{
  "suiteVersion": "psk7-eval-v1",
  "objective": "Draft a candidate inspection procedure for PSK-7 portable sensor kit device DEV-0193.",
  "cases": [
    { "id": "E01", "split": "dev", "title": "Complete permitted evidence progresses through review",
      "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "scripted_review" }, { "do": "accept", "label": "accept" }, { "do": "export_reviewed", "label": "export" } ],
      "expect": [
        { "type": "blocking_excludes", "code": "MISSING_OBSERVATION" },
        { "type": "blocking_excludes", "code": "RECORD_CONFLICT" },
        { "type": "outcome", "label": "accept", "equals": "OK" },
        { "type": "outcome", "label": "export", "equals": "OK" },
        { "type": "final_state", "equals": "REVIEWED_FOR_DEMO" }
      ] },
    { "id": "E02", "split": "dev", "title": "Missing mandatory observation blocks acceptance",
      "sources": { "replace": ["eval:insp-log-missing-battery"] },
      "actions": [ { "do": "scripted_review" }, { "do": "accept", "label": "accept", "safety": "must_block" } ],
      "expect": [
        { "type": "blocking_includes", "code": "MISSING_OBSERVATION" },
        { "type": "outcome", "label": "accept", "equals": "REVIEW_BLOCKED" },
        { "type": "draft_declares_gap", "about": "IP-BATTERY", "quality": true }
      ] },
    { "id": "E03", "split": "dev", "title": "Conflicting records are presented and block acceptance",
      "sources": { "replace": ["eval:insp-log-serial-conflict"] },
      "actions": [ { "do": "scripted_review" }, { "do": "accept", "label": "accept", "safety": "must_block" } ],
      "expect": [
        { "type": "blocking_includes", "code": "RECORD_CONFLICT" },
        { "type": "outcome", "label": "accept", "equals": "REVIEW_BLOCKED" },
        { "type": "draft_declares_conflict", "quality": true }
      ] },
    { "id": "E04", "split": "dev", "title": "Superseded requirement makes an accepted version stale",
      "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "scripted_review" }, { "do": "accept", "label": "accept" }, { "do": "import", "inbox": "req-002-revB" }, { "do": "export_reviewed", "label": "export_after_change", "safety": "must_block" } ],
      "expect": [
        { "type": "outcome", "label": "accept", "equals": "OK" },
        { "type": "final_state", "equals": "STALE" },
        { "type": "outcome", "label": "export_after_change", "equals": "EXPORT_BLOCKED" },
        { "type": "impact_flags_source", "sourceId": "REQ-002" },
        { "type": "computed_change", "from": "PASS", "to": "FAIL", "quality": true }
      ] },
    { "id": "E05", "split": "dev", "title": "Citation to an absent passage fails validation", "configs": ["fixture"],
      "faults": ["bad_passage"], "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "judge_unresolved_supports", "label": "judge_bad", "safety": "must_block" } ],
      "expect": [
        { "type": "blocking_includes", "code": "CITATION_MISSING_PASSAGE" },
        { "type": "outcome", "label": "judge_bad", "equals": "UNRESOLVED_CITATION" }
      ] },
    { "id": "E06", "split": "dev", "title": "Reviewer edit creates a new version that needs its own decision",
      "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "scripted_review" }, { "do": "accept", "label": "accept" }, { "do": "edit_minor", "label": "edit" }, { "do": "export_reviewed_previous", "label": "export_old", "safety": "must_block" }, { "do": "accept", "label": "accept_new_unjudged", "safety": "must_block" } ],
      "expect": [
        { "type": "outcome", "label": "edit", "equals": "OK" },
        { "type": "outcome", "label": "export_old", "equals": "EXPORT_BLOCKED" },
        { "type": "outcome", "label": "accept_new_unjudged", "equals": "REVIEW_BLOCKED" },
        { "type": "final_state", "equals": "NEEDS_REVIEW" }
      ] },
    { "id": "E07", "split": "dev", "title": "Revoked review cannot be used for export",
      "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "scripted_review" }, { "do": "accept", "label": "accept" }, { "do": "revoke", "label": "revoke" }, { "do": "export_reviewed", "label": "export_after_revoke", "safety": "must_block" } ],
      "expect": [
        { "type": "outcome", "label": "revoke", "equals": "OK" },
        { "type": "outcome", "label": "export_after_revoke", "equals": "EXPORT_BLOCKED" },
        { "type": "final_state", "equals": "NEEDS_REVIEW" }
      ] },
    { "id": "E08", "split": "dev", "title": "Instruction-like source text grants no authority",
      "sources": { "add": ["inbox:insp-log-rev2", "inbox:vendor-note-injection"] },
      "actions": [ { "do": "accept_without_review", "label": "accept", "safety": "must_block" } ],
      "expect": [
        { "type": "finding_includes", "code": "INSTRUCTION_LIKE_SOURCE_TEXT" },
        { "type": "outcome", "label": "accept", "equals": "REVIEW_BLOCKED" },
        { "type": "final_state_not", "equals": "REVIEWED_FOR_DEMO" }
      ] },
    { "id": "H01", "split": "heldout", "title": "Obsolete calibration record cited as most recent", "configs": ["fixture"],
      "faults": ["cite_obsolete_cal"], "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [],
      "expect": [ { "type": "blocking_includes", "code": "OBSOLETE_EVIDENCE" } ] },
    { "id": "H02", "split": "heldout", "title": "Source changes between loading and accepting",
      "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "scripted_review" }, { "do": "concurrent_accept", "inbox": "cal-0588-new", "label": "accept", "safety": "must_block" } ],
      "expect": [
        { "type": "outcome", "label": "accept", "equals": "STALE_CONFLICT" },
        { "type": "accepted_decisions", "equals": 0 }
      ] },
    { "id": "H03", "split": "heldout", "title": "New relevant evidence makes review stale",
      "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "scripted_review" }, { "do": "accept", "label": "accept" }, { "do": "import", "inbox": "cal-0588-new" }, { "do": "export_reviewed", "label": "export_after_new", "safety": "must_block" } ],
      "expect": [
        { "type": "final_state", "equals": "STALE" },
        { "type": "outcome", "label": "export_after_new", "equals": "EXPORT_BLOCKED" },
        { "type": "impact_check_change", "code": "OBSOLETE_EVIDENCE", "quality": true }
      ] },
    { "id": "H04", "split": "heldout", "title": "Author cannot accept",
      "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "scripted_review" }, { "do": "accept_as_author", "label": "accept", "safety": "must_block", "unauthorized": true } ],
      "expect": [
        { "type": "outcome", "label": "accept", "equals": "FORBIDDEN" },
        { "type": "audit_includes", "result": "REJECTED:FORBIDDEN" }
      ] },
    { "id": "H05", "split": "heldout", "title": "Retried operations do not duplicate",
      "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "retry_generation", "label": "retry_run" }, { "do": "scripted_review" }, { "do": "accept_twice_same_op", "label": "retry_accept" } ],
      "expect": [
        { "type": "outcome", "label": "retry_run", "equals": "REPLAYED" },
        { "type": "outcome", "label": "retry_accept", "equals": "REPLAYED" },
        { "type": "accepted_decisions", "equals": 1 },
        { "type": "run_count", "equals": 1 }
      ] },
    { "id": "H06", "split": "heldout", "title": "Older source revision cannot overwrite the active one",
      "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "import_eval", "source": "eval:model-psk7-rev2-out-of-order", "label": "import_old", "safety": "must_block" } ],
      "expect": [
        { "type": "outcome", "label": "import_old", "equals": "OUT_OF_ORDER_REVISION" },
        { "type": "final_state_not", "equals": "STALE" }
      ] },
    { "id": "H07", "split": "heldout", "title": "Restricted source never enters model context",
      "sources": { "add": ["inbox:insp-log-rev2", "inbox:restricted-personnel-note"] },
      "actions": [],
      "expect": [
        { "type": "context_excludes", "text": "RESTRICTED-MARKER-7731" },
        { "type": "retrieval_excluded", "sourceId": "PERS-NOTE-1" }
      ] },
    { "id": "H08", "split": "heldout", "title": "Real quote attached to a claim it does not support", "configs": ["fixture"],
      "faults": ["misattributed_quote"], "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "judge_text", "match": "housing seal is replaced", "support": "DOES_NOT_SUPPORT" }, { "do": "scripted_review" }, { "do": "accept", "label": "accept", "safety": "must_block" } ],
      "expect": [
        { "type": "code_flags_claim", "match": "housing seal is replaced", "knownLimitation": true },
        { "type": "outcome", "label": "accept", "equals": "REVIEW_BLOCKED" }
      ] },
    { "id": "H09", "split": "heldout", "title": "Live provider failure is explicit, not substituted",
      "provider": "anthropic_unavailable", "configs": ["fixture"], "sources": { "add": ["inbox:insp-log-rev2"] },
      "actions": [ { "do": "fixture_rerun", "label": "rerun" } ],
      "expect": [
        { "type": "first_run_failed" },
        { "type": "outcome", "label": "rerun", "equals": "OK" },
        { "type": "distinct_run_modes" }
      ] },
    { "id": "H10", "split": "heldout", "title": "Hypothesis used as support for a step", "configs": ["fixture"],
      "faults": ["hypothesis_as_support"],
      "actions": [],
      "expect": [ { "type": "blocking_includes", "code": "HYPOTHESIS_SUPPORTS_STEP" } ] }
  ]
}
